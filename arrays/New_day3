#include <iostream>
using namespace std;

#define SIZE 5   // Maximum size of queue

int queue[SIZE];
int front = -1;
int rear = -1;

// Function to check if queue is full
bool isFull() {
    return ((rear + 1) % SIZE == front);
}

// Function to check if queue is empty
bool isEmpty() {
    return (front == -1);
}

// Enqueue operation
void enqueue() {
    if (isFull()) {
        cout << "Queue is full. Cannot insert element.\n";
        return;
    }

    int value;
    cout << "Enter value to enqueue: ";
    cin >> value;

    if (front == -1) {
        front = 0;
    }

    rear = (rear + 1) % SIZE;
    queue[rear] = value;

    cout << "Element inserted successfully.\n";
}

// Dequeue operation
void dequeue() {
    if (isEmpty()) {
        cout << "Queue is empty. Cannot delete element.\n";
        return;
    }

    cout << "Deleted element: " << queue[front] << endl;

    if (front == rear) {
        front = rear = -1;
    } else {
        front = (front + 1) % SIZE;
    }
}

// Display queue elements
void displayQueue() {
    if (isEmpty()) {
        cout << "Queue is empty.\n";
        return;
    }

    cout << "Queue elements: ";
    int i = front;

    while (true) {
        cout << queue[i] << " ";
        if (i == rear)
            break;
        i = (i + 1) % SIZE;
    }
    cout << endl;
}

// Peek operation
void peek() {
    if (isEmpty()) {
        cout << "Queue is empty.\n";
    } else {
        cout << "Front element is: " << queue[front] << endl;
    }
}

// Main function
int main() {
    int choice;

    while (true) {
        cout << "\n===== CIRCULAR QUEUE MENU =====\n";
        cout << "1. Enqueue\n";
        cout << "2. Dequeue\n";
        cout << "3. Display Queue\n";
        cout << "4. Peek Front Element\n";
        cout << "5. Exit\n";

        cout << "Enter your choice (1-5): ";
        cin >> choice;

        switch (choice) {
            case 1:
                enqueue();
                break;
            case 2:
                dequeue();
                break;
            case 3:
                displayQueue();
                break;
            case 4:
                peek();
                break;
            case 5:
                cout << "Program exited successfully.\n";
                return 0;
            default:
                cout << "Invalid choice. Please try again.\n";
        }
    }
}
